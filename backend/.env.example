# ============================================
# GreenScene Backend — Environment Variables
# ============================================
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/greenscene

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret

# ---- Frontend URL (used for CORS, links in emails, etc.) ----
FRONTEND_URL=http://localhost:5173

# ---- Email (used for notifications) ----
EMAIL_USER=
EMAIL_PASSWORD=

# ---- Scrappy AI Assistant ----
# AI_PROVIDER selects which LLM backend Scrappy AI calls: "claude" or "openai"
AI_PROVIDER=claude

# Required if AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
